---
import PenNib from './PenNib.astro';
---

<header class="site-header">
  <div class="header-inner">
    <div class="title-row">
      <div class="nib">
        <PenNib />
      </div>
      <div class="title-column">
        <h1 class="site-title">
          <span class="word-part">Word</span><span class="sprint-part">Sprint</span>
        </h1>
        <p class="tagline">Track your daily writing journey</p>
      </div>
    </div>
  </div>
</header>

<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&display=swap');
.site-header {
  background: linear-gradient(160deg, #0d1b2a 0%, #1a2640 50%, #0d1b2a 100%);
  padding: 3.5rem 1.5rem 3rem;
  text-align: center;
  position: relative;
  overflow: hidden;
}
/* ambient glow */
.site-header::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 70% 50% at 50% -10%, rgba(201, 163, 90, 0.12) 0%, transparent 70%);
  pointer-events: none;
}
.header-inner {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
}
.site-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(3rem, 8vw, 5.5rem);
  font-weight: 400;
  letter-spacing: 0.01em;
  line-height: 1;
  margin: 0;
}
.title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
}
.title-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.word-part {
  background: linear-gradient(135deg, #e8e8f0 0%, #c8cfe0 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 400;
}
.sprint-part {
  background: linear-gradient(135deg, #d4aa65 0%, #e8c87a 50%, #c9a35a 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 700;
}
.nib {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tagline {
  font-style: italic;
  margin-top: 0.75rem;
  margin-bottom: 0;
  font-size: clamp(1rem, 2vw, 1.25rem);
  color: rgba(200, 207, 224, 0.8);
  font-family: 'Playfair Display', Georgia, serif;
  letter-spacing: 0.02em;
}
</style>
