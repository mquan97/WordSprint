<svg
  class="nib-svg"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 72 100"
  role="img"
  aria-label="Pen nib"
>
  <defs>
    <!-- Metallic horizontal gradient using the same gold tones as the 'Sprint' title -->
    <linearGradient id="nib-gold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%"   stop-color="#c9a35a"/>
      <stop offset="30%"  stop-color="#d4aa65"/>
      <stop offset="55%"  stop-color="#e8c87a"/>
      <stop offset="78%"  stop-color="#d4aa65"/>
      <stop offset="100%" stop-color="#c9a35a"/>
    </linearGradient>
  </defs>

  <!-- Nib body: two shoulder points at top with a slight concave curve between them -->
  <path
    d="M 8 26
       C 24 26, 32 32, 36 32
       C 40 32, 56 26, 64 26
       C 64 32, 68 44, 66 54
       C 62 74, 50 84, 36 94
       C 22 84, 10 74,  6 54
       C  4 44,  8 32,  8 26 Z"
    fill="url(#nib-gold)"
    stroke="#a07840"
    stroke-width="0.8"
    stroke-linejoin="round"
  />

  <!-- Vent / breather hole -->
  <ellipse cx="36" cy="44" rx="5.5" ry="7" fill="#1a0e04" opacity="0.85"/>

  <!-- Central slit from vent hole to tip -->
  <line
    x1="36" y1="92"
    x2="36" y2="50"
    stroke="#4e3208"
    stroke-width="1.1"
    stroke-linecap="round"
  />

  <!-- Left-tine metallic highlight -->
  <path
    d="M 16 44 C 13 57, 16 70, 26 82"
    fill="none"
    stroke="rgba(255,240,140,0.22)"
    stroke-width="2.5"
    stroke-linecap="round"
  />
</svg>

<style>
  .nib-svg {
    width: 44px;
    height: auto;
    display: block;
    animation: nib-appear 0.6s ease-out 0.2s both;
  }

  @keyframes nib-appear {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
